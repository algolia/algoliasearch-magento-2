{
  "name": "algolia/algoliasearch-magento-2",
  "description": "Algolia Search & Discovery extension for Magento 2",
  "type": "magento2-module",
  "license": ["MIT"],
  "version": "3.19.1",
  "require": {
    "php": "~8.3|~8.4|~8.5",
    "magento/framework": "~103.0",
    "algolia/algoliasearch-client-php": "^4.40.0",
    "guzzlehttp/guzzle": "^7.15.2",
    "ext-json": "*",
    "ext-PDO": "*",
    "ext-mbstring": "*",
    "ext-dom": "*"
  },
  "conflict": {
    "algolia/algoliasearch-adapter-magento-2": "<0.10.0",
    "algolia/algoliasearch-inventory-magento-2": "<1.5.0"
  },
  "suggest": {
      "algolia/algoliasearch-inventory-magento-2": "Algolia Search Inventory module for Magento 2.3.x,2.4.x and Algolia Search 1.12+ extension"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.magento.com/"
    }
  ],
  "require-dev": {
    "phpcompatibility/php-compatibility": "^9.2",
    "phpunit/phpunit": "^9.5|^10.5|^12.0"
  },
  "autoload": {
    "files": [ "registration.php" ],
    "psr-4": {
      "Algolia\\AlgoliaSearch\\": ""
    }
  }
}
